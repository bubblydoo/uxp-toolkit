  },
  "bugs": {
    "url": "https://github.com/bubblydoo/uxp-toolkit/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./setup-devtools-url": {
        "types": "./dist/setup-devtools-url.d.ts",
        "import": "./dist/setup-devtools-url.js"
      },
      "./uxp-logger": {
        "types": "./dist/uxp-logger.d.ts",
        "import": "./dist/uxp-logger.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "cdp-connector-plugin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs-json": "typedoc --json docs.json"
  },
  "dependencies": {
    "@adobe-fixed-uxp/uxp-devtools-core": "^1.6.6",
    "@adobe-fixed-uxp/uxp-devtools-helper": "^1.6.3",
