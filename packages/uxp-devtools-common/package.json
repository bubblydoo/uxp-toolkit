    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bubblydoo/tsconfig": "workspace:*",
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^20.8.7",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3"
  }
